<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景颜色 -->
    <solid android:color="#85FFC8C8" />

    <!-- 圆角半径 -->
    <corners android:radius="12dp" />

    <!-- 内边距（可选） -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />

</shape>
