<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avator"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="10dp"
        android:src="@drawable/icon_avatar"
        android:tint="#8BB9FF"
        app:layout_constraintTop_toBottomOf="@+id/tv1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <TextView
        android:id="@+id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="选择您的头像"
        android:textColor="#3F51B5"
        android:textStyle="bold"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="@+id/avator"
        app:layout_constraintStart_toStartOf="@+id/avator"
        app:layout_constraintTop_toBottomOf="@+id/avator" />


    <TextView
        android:id="@+id/tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="注册账号"
        android:textColor="#3F51B5"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        app:layout_constraintEnd_toEndOf="@+id/imageView"
        app:layout_constraintStart_toStartOf="@+id/imageView"
        app:layout_constraintTop_toTopOf="@+id/imageView" />

    <EditText
        android:layout_marginTop="10dp"
        android:id="@+id/phone"
        android:layout_width="300dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/imageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:hint="输入手机号"
        android:textColor="#8C8C8C"
        android:background="@drawable/bg_yuanjiao"
        android:backgroundTint="#34A9A9EB"/>

    <EditText
        android:layout_marginTop="10dp"
        android:id="@+id/nickname"
        android:layout_width="300dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/phone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:hint="输入昵称"
        android:textColor="#8C8C8C"
        android:background="@drawable/bg_yuanjiao"
        android:backgroundTint="#34A9A9EB"/>

    <EditText
        android:id="@+id/psw"
        android:layout_width="300dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/nickname"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:hint="输入密码"
        android:maxLength="16"
        android:inputType="textPassword"
        android:background="@drawable/bg_yuanjiao"
        android:backgroundTint="#34A9A9EB"/>

    <TextView
        android:id="@+id/showpsw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="显示密码"
        app:layout_constraintTop_toBottomOf="@id/psw"
        app:layout_constraintStart_toStartOf="@id/psw"
        android:textColor="#3F51B5"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/birthday"
        android:layout_width="300dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toBottomOf="@id/showpsw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:hint="选择生日"
        android:focusable="false"
        android:clickable="true"
        android:background="@drawable/bg_yuanjiao"
        android:backgroundTint="#34A9A9EB"/>

    <!-- 性别选择 -->
    <RadioGroup
        android:id="@+id/gender"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/birthday"
        app:layout_constraintStart_toStartOf="@id/psw"
        app:layout_constraintEnd_toEndOf="@id/psw"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/rb_male"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/radio_gender"
            android:gravity="center"
            android:text="男"
            android:textColor="@color/white"
            android:layout_marginEnd="5dp"/>

        <RadioButton
            android:id="@+id/rb_female"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/radio_gender"
            android:gravity="center"
            android:text="女"
            android:textColor="#FFFFFF"
            android:layout_marginStart="5dp"/>

    </RadioGroup>


    <TextView
        android:id="@+id/register"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="注册"
        android:textColor="@color/white"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:background="@drawable/bg_yuanjiao"
        android:backgroundTint="#3F51B5"
        app:layout_constraintEnd_toEndOf="@+id/psw"
        app:layout_constraintStart_toStartOf="@+id/psw"
        app:layout_constraintTop_toBottomOf="@+id/gender" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="注册成功将自动登录"
        android:textColor="#3F51B5"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@+id/register"
        app:layout_constraintStart_toStartOf="@+id/register"
        app:layout_constraintTop_toBottomOf="@+id/register" />




</androidx.constraintlayout.widget.ConstraintLayout>